{
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/Scripts/python.exe",
  "python.envFile": "${workspaceFolder}/.vscode/learning.env",
  "workbench.externalUriOpeners": {
    "https://*": "simpleBrowser.open",
    "http://*": "simpleBrowser.open"
  },
  "files.exclude": {
    "**/.venv": true,
    "**/.cache": true,
    "**/.runtime": true,
    "**/__pycache__": true
  },
  "search.exclude": {
    "arena/ARENA_3.0": true,
    "arena/validation/executed": true,
    "arena/validation/sequential": true
  },
  "python.analysis.exclude": [
    "**/.git",
    "**/node_modules",
    "**/__pycache__",
    "**/.venv",
    "**/.cache",
    "**/.pytest_cache",
    "**/.ruff_cache",
    "**/.runtime",
    "**/.ipynb_checkpoints",
    "arena/outputs",
    "arena/validation/executed",
    "arena/validation/sequential"
  ],
  "files.watcherExclude": {
    "**/.venv/**": true,
    "**/.cache/**": true,
    "**/.runtime/**": true,
    "**/__pycache__/**": true,
    "**/.pytest_cache/**": true,
    "**/.ruff_cache/**": true,
    "**/.ipynb_checkpoints/**": true,
    "**/arena/outputs/**": true,
    "**/arena/validation/executed/**": true,
    "**/arena/validation/sequential/**": true
  }
}
